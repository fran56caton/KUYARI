{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{cloud/schema.sql,dist/cloud/**,dist/shared/**,assets/**,index.html,styles.css,dist/client/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "framework": null,
  "outputDirectory": "public"
}
