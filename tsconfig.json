{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": ".",
    "noEmitOnError": true, "sourceMap": false
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "client/**/*.ts", "shared/**/*.ts"]
}
